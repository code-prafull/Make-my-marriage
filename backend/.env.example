# Server
NODE_ENV=development
PORT=5000

# MongoDB (local MongoDB or MongoDB Atlas connection string)
# Local standalone mongod: add ?retryWrites=false (no replica set → no retryable writes/transactions)
# MongoDB Atlas: transactions supported, retryWrites can stay enabled (default)
MONGODB_URI=mongodb://127.0.0.1:27017/make-my-marriage?retryWrites=false

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_MS=604800000

# CORS — frontend origin(s), comma separated
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Email (optional — emails are printed to the console when SMTP is not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MakeMyMarriage <no-reply@makemymarriage.local>"
FRONTEND_URL=http://localhost:5174
